# Exact Core Platform admin origin allowed to send local preview messages.
VITE_CORE_PLATFORM_ADMIN_ORIGIN=https://admin.better-farms.example
# Exact public origin used by the server to publish canonical URLs. Leave unset until approved.
PUBLIC_SITE_ORIGIN=https://better-farms.example
# Credential-free Core Platform origin used only by the server-side content and form proxy.
# Leave unset until the client-specific Core form destinations are provisioned and approved.
CORE_PLATFORM_API_ORIGIN=https://core-platform.example
